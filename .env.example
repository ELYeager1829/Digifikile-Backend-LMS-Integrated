# Database
ConnectionStrings__DigiFikileLmsDb=Host=...;Port=5432;Database=...;Username=...;Password=...;SslMode=Require

# JWT
Jwt__SecretKey=replace-with-a-long-random-secret
ASPNETCORE_ENVIRONMENT=Development
PORT=5001

# SMTP used for login OTPs, password-reset OTPs and SETA Admin invitations
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=replace-with-smtp-password

# Frontend URL embedded in SETA Administrator invitation e-mails
FRONTEND_BASE_URL=http://localhost:5173
